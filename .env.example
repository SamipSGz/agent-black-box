# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- OpenTelemetry / SigNoz ingest ---
# When SigNoz is running via its own docker compose, the OTel collector
# listens on 4317 (gRPC) and 4318 (HTTP). We use HTTP here.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=agent-black-box
# Bump this between demo runs to show "error rate by agent version" splits.
AGENT_VERSION=v1

# --- SigNoz query API (used by the SRE copilot to gather evidence) ---
# UI: http://localhost:8080  (older builds: http://localhost:3301)
SIGNOZ_API_URL=http://localhost:8080
# Create under Settings -> API Keys in the SigNoz UI.
SIGNOZ_API_KEY=

# --- SRE copilot webhook server ---
COPILOT_HOST=0.0.0.0
COPILOT_PORT=8099

# Retry budget for the fix/replay demo. 0 = buggy v1 (retry storm);
# set RETRY_BUDGET=3 with AGENT_VERSION=v2 for the fixed "after" run.
RETRY_BUDGET=0
